@startuml
title Diagrama de Secuencia - Importar Preguntas (Diseño) - Jorgestor

actor "Docente" as Teacher
participant "Frontend (React)" as FE
participant "PreguntaController" as Controller
participant "PreguntaService" as Service
participant "ImportadorService" as Importador
participant "Repository" as Repository

Teacher -> FE: Sube archivo (CSV/JSON)
activate FE

FE -> Controller: POST /api/preguntas/importar\n(Archivo + AsignaturaId)
activate Controller

Controller -> Importador: procesarArchivo(archivo)
activate Importador
Importador --> Controller: List<PreguntaDTO> extraidas
deactivate Importador

Controller -> Service: crearPreguntas(listaPreguntas, asignaturaId)
activate Service

loop Para cada PreguntaDTO
    Service -> Repository: save(pregunta)
end
Repository --> Service: void
deactivate Service

Controller --> FE: 200 OK
deactivate Controller
deactivate FE

@enduml
