@startuml
title Diagrama de Secuencia - Importar Asignaturas (Diseño) - Jorgestor

actor "Docente" as Teacher
participant "Frontend (React)" as FE
participant "AsignaturaController" as Controller
participant "AsignaturaService" as Service
participant "ImportadorService" as Importador
participant "Repository" as Repository

Teacher -> FE: Sube archivo (CSV/JSON)
activate FE

FE -> Controller: POST /api/asignaturas/importar\n(Archivo)
activate Controller

Controller -> Importador: procesarArchivo(archivo)
activate Importador
Importador --> Controller: List<AsignaturaDTO> extraidas
deactivate Importador

Controller -> Service: crearAsignaturas(listaAsignaturas)
activate Service

loop Para cada AsignaturaDTO
    Service -> Repository: save(asignatura)
end
Repository --> Service: void
deactivate Service

Controller --> FE: 200 OK
deactivate Controller
deactivate FE

@enduml
