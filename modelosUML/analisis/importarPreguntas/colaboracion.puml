@startuml importarPreguntas-analisis
skinparam linetype polyline

rectangle #CDEBA5 ":PREGUNTAS_ABIERTO" as PreguntasAbierto
rectangle #CDEBA5 ":PREGUNTAS_CONTEXTUALES_ABIERTO" as PreguntasContextualesAbierto
rectangle #CDEBA5 ":Collaboration CompletarGestion" as CompletarGestion

package importarPreguntas as "importarPreguntas()" {
    rectangle #629EF9 ImportarPreguntasView
    rectangle #b5bd68 PreguntaController
    rectangle #F2AC4E ImportadorPreguntas
    rectangle #F2AC4E PreguntaRepository
}

PreguntasAbierto --> ImportarPreguntasView: importarPreguntas()
PreguntasContextualesAbierto --> ImportarPreguntasView: importarPreguntas()

ImportarPreguntasView -d-> PreguntaController: procesarImportacion(archivo)

PreguntaController --> ImportadorPreguntas: parsearPreguntas(archivo)
PreguntaController --> PreguntaRepository: guardarPreguntas(lista)

ImportarPreguntasView ..> PreguntasAbierto: <<include>> [éxito]
ImportarPreguntasView ..> PreguntasContextualesAbierto: <<include>> [éxito contextual]
ImportarPreguntasView ..> CompletarGestion: <<include>> completarGestion() [cancelación/error]

@enduml
