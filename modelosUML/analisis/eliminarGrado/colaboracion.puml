@startuml eliminarGrado-analisis
skinparam linetype polyline

rectangle #CDEBA5 ":GRADOS_ABIERTO" as GradosAbierto
rectangle #CDEBA5 ":GRADO_ABIERTO" as GradoAbierto
rectangle #CDEBA5 ":Collaboration VerGrados" as CollaborationVerGrados

package eliminarGrado as "eliminarGrado()" {
    rectangle #629EF9 EliminarGradoView
    rectangle #b5bd68 GradoController
    rectangle #F2AC4E GradoRepository
    rectangle #F2AC4E Grado
}

GradosAbierto --> EliminarGradoView: eliminarGrado(id)
GradoAbierto --> EliminarGradoView: eliminarGrado(id)

EliminarGradoView -d-> GradoController: confirmarEliminacion(id) : boolean

GradoController --> GradoRepository: eliminar(id) : boolean

GradoRepository -- Grado

EliminarGradoView ..> CollaborationVerGrados: <<include>> verGrados()

@enduml
