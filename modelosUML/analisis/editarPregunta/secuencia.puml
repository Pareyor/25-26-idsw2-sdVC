@startuml editarPregunta-secuencia
skinparam linetype polyline

participant ":PREGUNTAS_ABIERTO" as Sistema
participant ":EditarPreguntaView" as View
participant ":PreguntaController" as Controller
participant ":PreguntaRepository" as Repository
participant ":Pregunta" as Entity

Sistema -> View: editarPregunta(id)
activate View

View -> Controller: obtenerPregunta(id)
activate Controller

Controller -> Repository: findById(id)
activate Repository

Repository -> Entity: crear instancia
deactivate Repository

Controller <- Repository: Pregunta
deactivate Controller

View <- Controller: Pregunta
deactivate View

note over View
Presenta datos de la pregunta:
• Enunciado, Asignatura, Tema, Dificultad
• Estado (Habilitada/Deshabilitada)
• Permite: modificar, guardar, eliminar, cancelar, ver respuestas
end note

View -> Controller: actualizarPregunta(datos)
activate Controller

Controller -> Entity: aplicarCambios(datos)
activate Entity
deactivate Entity

Controller -> Repository: save(pregunta)
activate Repository
deactivate Repository

View <- Controller: exito
deactivate Controller

note over View
Presenta mensaje de éxito
Mantiene sesión de edición activa
end note

@enduml